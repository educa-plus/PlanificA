; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="PlanificA+"
config/description="PlanificA+ est un logiciel de gestion conçue pour les enseignants du Québec, notamment afin de répondre aux besoins spécifiques du système scolaire québécois tel que les horaires cycliques et l'aspect séquentiel des cours. Il permet de planifier et d'organiser des cours de manière détaillée et flexible.
PlanificA+ est une intiative open source. Il est gratuit et n'importe qui peut contribuer à son évolution, que ce soit par des commentaires constructifs, en proposant des amélioration du code ou en contribuant financièrement."
config/version="0.2.1.0"
run/main_scene="uid://bo7r3oe1fdgli"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/image="uid://ds6epko8kwq3w"
config/icon="uid://eio251ugxoj2"

[autoload]

global_variables="*res://global_scripts/global_variables.gd"
time_functions="*res://global_scripts/time_functions.gd"
TooltipManager="*res://addons/tooltips_pro/scripts/tooltip_manager.gd"
TooltipPlaceholderVariables="*res://addons/tooltips_pro/scripts/tooltip_placeholder_variables.gd"
ANIMA="*uid://wkshjam2e31h"
GouvDocumentation="*res://Resources/Gouv_documentation.gd"

[display]

window/size/viewport_width=1366
window/size/viewport_height=768
window/size/mode=2

[editor_plugins]

enabled=PackedStringArray("res://addons/ReorderableContainer/plugin.cfg", "res://addons/anima/plugin.cfg", "res://addons/easy_charts/plugin.cfg", "res://addons/tnowe_extra_controls/plugin.cfg", "res://addons/tooltips_pro/plugin.cfg")

[gui]

theme/custom="uid://da2np1q3tcni"
theme/custom_font="uid://ft0jxjjuj8nk"

